@model IEnumerable<Department>
<div id="DivMassage" class="alert alert-success mt-3" style="margin-left:80%">
    @TempData["massage"]
</div>
@{
    ViewData["Title"] = "All Departments ";
}
<a type="button" class="btn btn-success" asp-action="Create">Create New Deparment</a>
<br />

@if(Model.Count()>0)
{
    <h1 style="padding-left:35%">All Departments</h1>
    <br/>
    
    <table class="table table-striped table-hover mt-3">
        <thead>
            <tr>
                <td>Code</td>
                <td>Name</td>
                <td>DateOfCreation</td>
                <td>Details</td>
                <td>Update</td>
                <td>Delete</td>
            </tr>
        </thead>
        <tbody>
            @foreach(var department in Model)
            {
             <tr>
                <td>@department.Code</td>
                <td>@department.Name</td>
                <td>@department.DateOfCreation</td>
                    <partial name="_ButtonsPartialView" model="@department.Id" />
             </tr>
            }

        </tbody>
    </table>
    
}
else
{ <h1>Departments not found</h1>}

