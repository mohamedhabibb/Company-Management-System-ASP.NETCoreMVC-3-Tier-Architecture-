@model EmployeeViewModel
@if(Model.ImageName is not null)
{
    <div ="mb-3" mb-4>
       <img src="~/Files/Images/@Model.ImageName" class="rounded" height="100" width="100" />
        <input asp-for="ImageName" hidden>

    </div>
    
}

<div class="mb-3">
    <label class="form-label" asp-for="Name"></label>
    <input readonly class="form-control" asp-for="Name" placeholder="enter Name">
</div>
<div class="mb-3">
    <label class="form-label" asp-for="Age"></label>
    <input readonly class="form-control" asp-for="Age" placeholder="enter Age">
</div>
<div class="mb-3">
    <label class="form-label" asp-for="Salary"></label>
    <input readonly class="form-control" asp-for="Salary" placeholder="enter Salary">
</div>
<div class="mb-3">
    <label class="form-label" asp-for="Address"></label>
    <input readonly class="form-control" asp-for="Address" placeholder="enter Address">
    <span class="text-danger" asp-validation-for="Address"></span>
</div>
<div class="mb-3">
    <label class="form-label" asp-for="Email"></label>
    <input readonly class="form-control" asp-for="Email" placeholder="enter Email">
</div>
<div class="mb-3">
    <label class="form-label" asp-for="PhoneNumber"></label>
    <input readonly class="form-control" asp-for="PhoneNumber" placeholder="enter PhoneNumber">
</div>
<div class="mb-3">
    <label class="form-label" asp-for="HireDate"></label>
    <input readonly class="form-control" asp-for="HireDate" placeholder="enter HireDate">
</div>
<div class="mb-3">
    <label class="form-label" asp-for="IsActive"></label>
    <input readonly class="form-control" asp-for="IsActive" placeholder="enter IsActive">
</div>
<button type="submit" class="btn btn-danger">Delete</button>
<a type="button" class="btn btn-warning" asp-action="Index"> Back to list</a>
