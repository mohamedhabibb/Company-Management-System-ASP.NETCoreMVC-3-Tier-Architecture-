@model Department

<div class="mb-3">
    <label class="form-label" asp-for="Code"></label>
    <input class="form-control" asp-for="Code" placeholder="enter code">
    <span class="text-danger" asp-validation-for="Code"></span>
</div>
<div class="mb-3">
    <label class="form-label" asp-for="Name"></label>
    <input class="form-control" asp-for="Name" placeholder="enter name">
    <span class="text-danger" asp-validation-for="Name"></span>
</div>
<div class="mb-3">
    <label class="form-label" asp-for="DateOfCreation"></label>
    <input class="form-control" asp-for="DateOfCreation" placeholder="enter date of creation">
    <span class="text-danger" asp-validation-for="DateOfCreation"></span>
</div>
<button type="submit" class="btn btn-primary">Submit</button>
<a type="button" class="btn btn-warning" asp-action="Index"> Back to list</a>